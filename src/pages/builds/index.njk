{% set page_title = 'Builds' %}
{% set page_description = 'View past projects in action'%}

{% extends '_page.njk' %}

{% import 'macros/_archive-preview.njk' as preview %}

{% block main %}

   <h1 class="heading-1 margin-bottom-1">Samples</h1>
   <p class="paragraph margin-bottom-2">View demos of things I've built for employers and small projects I did for honing my design and development skills.</p>

   <section class="margin-bottom-2">
      <h2 class="heading-2 margin-bottom-1">Web Apps</h2>
      <p class="paragraph margin-bottom-1">A mixture of personal projects, demos of client projects, and tutorial projects.</p>

      <div class="gallery">
         {{ preview.settings(icon_path, "Sudoku Checker in MERN", "https://sudoku.caitlinteague.com", "sudoku-checker.jpg?v=1", "https://github.com/caitlinteaguedesign/sudoku-app") }}
         {{ preview.settings(icon_path, "Dashboard", "/archive/dashboard/", "dashboard.jpg", "https://github.com/caitlinteaguedesign/dashboard-demo") }}
         {{ preview.settings(icon_path, "Tic-Tac-Toe in React", "/archive/tic-tac-toe/", "tic-tac-toe-v2.jpg", "https://github.com/caitlinteaguedesign/tic-tac-toe-2025") }}
				 {{ preview.settings(icon_path, "NitroCSS", "/archive/nitro/", "nitrocss.png", "https://github.com/caitlinteaguedesign/nitrocss") }}
         {{ preview.settings(icon_path, "Pong in Canvas and JavaScript", "/archive/pong/", "pong.jpg") }}
      </div>

   </section>
   
   <section>
      <h2 class="heading-2 margin-bottom-1">CSS Experiments</h2>
      <p class="paragraph margin-bottom-1">UI themes based on book cover designs, an idea inspired by <a href="https://garrickvanburen.com" class="link_style-primary">Garrick van Buren</a>'s Kernest project and <a href="https://jensimmons.com/" class="link_style-primary">Jen Simmons</a>'s YouTube series on CSS grid.</p>
      <div class="gallery">
         {{ preview.settings(icon_path, "Murder at the Brightwell", "/archive/brightwell/", "brightwell.jpg") }}
         {{ preview.settings(icon_path, "Between the World and Me", "/archive/between-the-world-and-me/", "between-the-world-and-me.jpg") }}
         {{ preview.settings(icon_path, "Other Women", "/archive/other-women/", "other-women.jpg") }}
      </div>
   </section>

{% endblock %}